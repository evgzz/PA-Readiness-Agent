{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prohibited_proposals",
    "blocked_attempts",
    "confirmed_unauthorized_effects",
    "unresolved_effects"
  ],
  "properties": {
    "prohibited_proposals": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "confirmed_unauthorized_effects": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_effects": {
      "type": "integer",
      "minimum": 0
    }
  }
}

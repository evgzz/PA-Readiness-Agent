{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_ref": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric_registry_version": {
      "const": "1.0-proposed"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "snapshot_ref",
    "snapshot_digest",
    "metric_registry_version",
    "as_of"
  ]
}

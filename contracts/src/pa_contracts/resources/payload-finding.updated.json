{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "OPEN",
        "MITIGATING",
        "PENDING_VERIFICATION",
        "VERIFIED_CLOSED",
        "REOPENED",
        "RISK_ACCEPTED"
      ]
    },
    "severity": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "finding_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "record_version",
    "actor_id",
    "state",
    "severity",
    "finding_ref",
    "evidence_refs"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PENDING",
        "AUTHORIZED",
        "REJECTED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "actor_id",
    "candidate_config_digest",
    "gate_snapshot_digest",
    "authorization_ref",
    "state",
    "expires_at"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "RECORDED"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "REFERENCE_CONTROL",
        "SCRIPTED_DEMO",
        "REAL_AGENT_SYNTHETIC",
        "REAL_AGENT_PRODUCTION"
      ]
    },
    "candidate_config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "taxonomy_id": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "review_disposition": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "INCONCLUSIVE"
      ]
    },
    "reviewer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category_id": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "inclusion_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exclusion_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "positive_example_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "counterexample_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "introduced_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "category_id",
          "definition",
          "inclusion_rules",
          "exclusion_rules",
          "positive_example_refs",
          "counterexample_refs",
          "introduced_version"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "suggested_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "category_required_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "observed_findings_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "status",
    "record_id",
    "record_version",
    "created_at",
    "actor_id",
    "evidence_class",
    "candidate_config_digest",
    "evaluation_config_digest",
    "evidence_refs",
    "taxonomy_id",
    "taxonomy_version",
    "review_disposition",
    "reviewer_ids",
    "categories",
    "suggested_dimensions",
    "category_required_fields",
    "observed_findings_count"
  ]
}

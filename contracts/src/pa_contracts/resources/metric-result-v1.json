{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metric_id": {
      "enum": [
        "M01",
        "M02",
        "M03",
        "M04",
        "M05",
        "M06",
        "Q01",
        "Q02",
        "Q03",
        "Q04",
        "Q05",
        "Q06",
        "Q07",
        "Q08",
        "Q09"
      ]
    },
    "metric_registry_version": {
      "const": "1.0-proposed"
    },
    "status": {
      "enum": [
        "COMPUTED",
        "N/A",
        "NOT_RUN",
        "UNRESOLVED",
        "INCOMPLETE",
        "STALE"
      ]
    },
    "value": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "numerator": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "denominator": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligible_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "missing_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "applicability_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_snapshot_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "metric_id",
    "metric_registry_version",
    "status",
    "value",
    "numerator",
    "denominator",
    "eligible_count",
    "unresolved_count",
    "missing_count",
    "applicability_reason",
    "source_snapshot_digest",
    "evidence_refs"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "destination_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "ACKNOWLEDGED",
        "RETRYING",
        "FAILED",
        "DISABLED"
      ]
    },
    "pending_events": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "destination_id",
    "checkpoint_ref",
    "state",
    "pending_events"
  ]
}

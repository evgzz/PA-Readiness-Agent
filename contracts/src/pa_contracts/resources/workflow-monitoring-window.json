{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "RECORDED"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "REFERENCE_CONTROL",
        "SCRIPTED_DEMO",
        "REAL_AGENT_SYNTHETIC",
        "REAL_AGENT_PRODUCTION"
      ]
    },
    "candidate_config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "monitoring_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "window_id": {
      "type": "string",
      "minLength": 1
    },
    "window_revision": {
      "type": "integer",
      "minimum": 1
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "cohort_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_snapshot_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eligible_admitted_runs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "complete_records": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "missing_records": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "late_records": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "label_pending_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "source_freshness": {
      "anyOf": [
        {
          "enum": [
            "FRESH",
            "STALE",
            "UNKNOWN"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "metric_snapshot_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "signal_type": {
      "anyOf": [
        {
          "enum": [
            "CONFIRMED_QUALITY",
            "PROXY_SHIFT",
            "EVIDENCE_FAILURE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "signal_method": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "signal_status": {
      "enum": [
        "DETECTED",
        "NOT_DETECTED",
        "INSUFFICIENT_DATA",
        "STALE"
      ]
    },
    "uncertainty": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          },
          "required": [
            "method",
            "lower",
            "upper",
            "confidence"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "triage_record_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "finding_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "record_id",
    "record_version",
    "created_at",
    "actor_id",
    "evidence_class",
    "candidate_config_digest",
    "evaluation_config_digest",
    "evidence_refs",
    "monitoring_plan_id",
    "window_id",
    "window_revision",
    "window_start",
    "window_end",
    "as_of",
    "cohort_digest",
    "reference_snapshot_digest",
    "input_snapshot_digest",
    "eligible_admitted_runs",
    "complete_records",
    "missing_records",
    "late_records",
    "label_pending_count",
    "source_freshness",
    "metric_snapshot_ref",
    "signal_type",
    "signal_method",
    "signal_status",
    "uncertainty",
    "triage_record_ref",
    "finding_id"
  ]
}

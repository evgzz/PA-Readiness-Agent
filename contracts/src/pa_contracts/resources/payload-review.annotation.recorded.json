{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "RECORDED"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "REFERENCE_CONTROL",
        "SCRIPTED_DEMO",
        "REAL_AGENT_SYNTHETIC",
        "REAL_AGENT_PRODUCTION"
      ]
    },
    "candidate_config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_config_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "review_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewability": {
      "enum": [
        "REVIEWABLE",
        "UNREVIEWABLE"
      ]
    },
    "unreviewable_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "intended_behavior": {
      "type": "string",
      "minLength": 1
    },
    "observed_behavior": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNRESOLVED"
      ]
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "symptom": {
      "type": "string",
      "minLength": 1
    },
    "suspected_cause": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "cause_status": {
      "enum": [
        "SUSPECTED",
        "SUPPORTED",
        "UNRESOLVED"
      ]
    },
    "severity": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "UNRESOLVED"
      ]
    },
    "severity_rationale": {
      "type": "string",
      "minLength": 1
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "adjudication_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_annotation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "record_id",
    "record_version",
    "created_at",
    "actor_id",
    "evidence_class",
    "candidate_config_digest",
    "evaluation_config_digest",
    "evidence_refs",
    "annotation_id",
    "review_batch_id",
    "run_id",
    "trial_id",
    "case_id",
    "family_id",
    "trace_ref",
    "reviewer_role",
    "reviewed_at",
    "reviewability",
    "unreviewable_reason",
    "intended_behavior",
    "observed_behavior",
    "verdict",
    "category_ids",
    "taxonomy_version",
    "symptom",
    "suspected_cause",
    "cause_status",
    "severity",
    "severity_rationale",
    "ambiguities",
    "adjudication_ref",
    "supersedes_annotation_id"
  ]
}

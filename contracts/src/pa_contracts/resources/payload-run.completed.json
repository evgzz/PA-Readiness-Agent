{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "terminal_outcome": {
      "enum": [
        "DELIVERED",
        "ERROR",
        "TIMEOUT",
        "CANCELLED"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "assessment_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "terminal_outcome",
    "duration_ms",
    "assessment_ref",
    "unresolved_checks"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "destination_class": {
      "type": "string",
      "minLength": 1
    },
    "arguments_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "action_id",
    "scope_ref",
    "policy_digest",
    "operation",
    "destination_class",
    "arguments_digest",
    "decision",
    "reason_code"
  ]
}
